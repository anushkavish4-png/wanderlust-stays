<% layout("/layouts/boilerplate") %> 

<!-- <h2>All Listings</h2> -->
<style>
  #filters {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 7% 35px;
    padding: 15px 20px;
    background-color: white;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    min-height: 125px;
    box-sizing: border-box;
  }

  .filter{
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.8;
    position: relative;
    z-index: 1;
  }


.filter::before {
    content: "";
    position: absolute;
    width: 90px;
    height: 90px;
    border-radius: 15px;
    background-color: #ff385c;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    z-index: -1;
    transition: all 0.25s ease;
}

.filter:hover::before {
    opacity: 1;
}

.filter:hover i,
.filter:hover p {
    color: white;
}

  /* .filter p{
    font-size: 0.8rem;
  } */

  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

  .tax-info{
    display: none;
  }

 .tax-toggle {
    border: 1px solid  #ff385c;
    border-radius: 15px;
    height: 60px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 20px;
    box-sizing: border-box;
}

.tax-toggle .form-check {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
}

.tax-toggle .form-check-label {
    margin: 0;
    white-space: nowrap;
    font-size: 16px;
}

.tax-toggle .form-check-input {
    width: 38px;
    height: 20px;
    margin: 0;
    flex-shrink: 0;
}
  
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-sun"></i></div>
    <p>Mountaines</p>
  </div>
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castels</p>
  </div>
  <div class="filter">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-seedling"></i></div>
    <p>Farma</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-umbrella-beach"></i></div>
    <p>Beach</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-skating"></i></div>
    <p>Iceland</p>
  </div>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
  </div>
</div>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
          <img src="<%= listing.image.url %>"
               class="card-img-top"
               alt="listing-image"
               style="height:20rem;">
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
               <span class="listing-price">
                 &#8377; <%= listing.price.toLocaleString("en-IN") %> 
               </span>
               / night
              <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>
<script>
    const taxSwitch = document.getElementById("switchCheckDefault");

    taxSwitch.addEventListener("click", function () {

        const taxInfo = document.getElementsByClassName("tax-info");

        for (let info of taxInfo) {
            if (info.style.display !== "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>
